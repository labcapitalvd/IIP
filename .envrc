export GITHUB_TOKEN_COMMONS=$(secret-tool lookup type "PAT" context "Repo Commons" content github_token)
export GITHUB_TOKEN_SEEDS=$(secret-tool lookup type "PAT" context "Repo Data" content github_token)
export GITHUB_TOKEN_IIP=$(secret-tool lookup type "PAT" context "Repo IIP" content github_token)
export POSTGRES_PASSWORD=$(secret-tool lookup type "PASS" context "POSTGRES PASSWORD" content POSTGRES_PASSWORD)
export FERNET_PASSWORD=$(secret-tool lookup type "PASS" context "FERNET PASSWORD" content FERNET_PASSWORD)

source_env "$(uv sync --quiet && echo .venv/bin/activate)"
use flake path:.
