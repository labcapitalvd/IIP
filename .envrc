export SOPS_AGE_KEY_FILE="$HOME/.config/sops/age/keys.txt"

if [ -f "$(find_up secrets.yaml)" ]; then
  watch_file "$(find_up secrets.yaml)"
  eval "$("$direnv" dotenv bash <(sops -d --output-type dotenv secrets.yaml))"
fi

source_env "$(uv sync --quiet && echo .venv/bin/activate)"
use flake path:.
